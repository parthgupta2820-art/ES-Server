# Smart Gate backend configuration
# Copy this file to .env, then replace the API key placeholders.
#   macOS/Linux: cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local MongoDB default:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_gate
# For MongoDB Atlas, replace all <...> values:
# MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/<DATABASE>

# Python AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_RECOGNITION_ENDPOINT=/recognize
AI_TIMEOUT_MS=15000

# API keys - use different, random values. Never commit the real .env file.
ESP32_API_KEY=change_this_device_key
ADMIN_API_KEY=change_this_admin_key

# Access rules
MIN_OCR_CONFIDENCE=0.80
MAX_FILE_SIZE_MB=5
